// Cloudflare Workers の設定（画面と地図データの配信、/api/* の転送。D42・D44）。デプロイは CI（.github/workflows/ci.yml）が行う
{
  "name": "yamon-site",
  // CI のデプロイは node_modules なしで束ねる。worker/ からは相対パスのファイルだけを import する
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // PR ごとのプレビュー（Workers Previews、pr-<番号>-yamon-site.<サブドメイン>.workers.dev）に使う
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 画面のパス（/event-detail/xxx など）を直接開いたり再読み込みしたりしたときは index.html を返す
    "not_found_handling": "single-page-application",
    // ここに書いたパスは、静的ファイルより先に必ず Worker を通す。静的ファイルに当たったリクエストは Worker を通らず、
    // 無料枠のリクエスト数も使わない（どのファイルにも当たらないリクエストは Worker に来る）
    "run_worker_first": ["/api/*", "/map/*"]
  },
  // R2 の地図データ（D28・D29、docs/MAP_DATA.md）。worker/map/serve.ts が env.MAP_DATA から読む。
  // バケットを消したり名前を変えたりすると、デプロイが失敗する
  "r2_buckets": [{ "binding": "MAP_DATA", "bucket_name": "yamon-map" }],
  // PR のプレビュー（wrangler preview）の設定。プレビューは上の本番の設定・Secret（API_ORIGIN・PROXY_SECRET）・バインディングを引き継がない。
  // ここにも API の Secret を入れないので、プレビューの /api/* は 503 を返し、本番のデータにつながらない（D45）
  "previews": {
    // 地図データは公開してよいもので、Worker からは読むだけなので、プレビューも本番と同じバケットを読む
    "r2_buckets": [{ "binding": "MAP_DATA", "bucket_name": "yamon-map" }]
  }
}
