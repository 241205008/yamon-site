{
  "name": "yamon-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"npm run dev -w @yamon/web\" \"npm run dev -w @yamon/api\"",
    "dev:web": "npm run dev -w @yamon/web --",
    "dev:api": "npm run dev -w @yamon/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
